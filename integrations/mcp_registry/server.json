{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.gowrishankar-infra/velaris",
  "title": "Velaris",
  "description": "Write Velaris, audit what it can touch, and run it under an effect budget.",
  "repository": {
    "url": "https://github.com/gowrishankar-infra/velaris-lang",
    "source": "github"
  },
  "websiteUrl": "https://gowrishankar-infra.github.io/velaris-lang/",
  "version": "7.1.1",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "velaris-lang",
      "version": "7.1.1",
      "runtimeHint": "python",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "-m"
        },
        {
          "type": "positional",
          "value": "velaris_mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    },
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "velaris-lang",
      "version": "7.1.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
