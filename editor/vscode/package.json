{
  "name": "velaris",
  "displayName": "Velaris",
  "description": "Velaris language support: syntax highlighting, and live errors and proofs from the real compiler.",
  "version": "8.5.0",
  "publisher": "gowrishankar-infra",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "contributes": {
    "languages": [
      {
        "id": "velaris",
        "aliases": [
          "Velaris",
          "velaris"
        ],
        "extensions": [
          ".vel"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "velaris",
        "scopeName": "source.velaris",
        "path": "./syntaxes/velaris.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Velaris",
      "properties": {
        "velaris.command": {
          "type": "string",
          "default": "velaris",
          "description": "How to run Velaris (a path, if it is not on your PATH)."
        },
        "velaris.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Check the file and prove its promises when you save."
        }
      }
    },
    "snippets": [
      {
        "language": "velaris",
        "path": "./snippets/velaris.json"
      }
    ]
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:velaris"
  ],
  "license": "MIT",
  "icon": "icon.png",
  "keywords": [
    "velaris",
    "verification",
    "contracts",
    "effects",
    "formal methods"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gowrishankar-infra/velaris-lang"
  },
  "bugs": {
    "url": "https://github.com/gowrishankar-infra/velaris-lang/issues"
  },
  "homepage": "https://velaris-lang.dev/",
  "galleryBanner": {
    "color": "#101418",
    "theme": "dark"
  }
}