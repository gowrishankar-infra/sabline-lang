// Talking to a REST API, without the plumbing: a request with a bound on
// its retries, JSON bodies, headers from a map, and the items of a JSON list.
//
// import "rest.vel" as rest
// check rest.call_json("POST", url, json_of({"name": "x"}), {"Accept": "application/json"}) {
// ok answer { ... answer.status, answer.body ... }  fail why { ... }
// }
//
// New in 8.5, for stdlib/k8s.vel and stdlib/aws.vel and for any program of
// the same kind. It is a file of its own, and http.vel is as it was: a
// program that imports http.vel without a name and has a function called
// `items` or `succeeded` of its own would otherwise have stopped compiling
// (E513), and a minor version does not do that.

record RestAnswer {
    status: Int
    body: Text
    raw: Text
}

fn call(method: Text, url: Text, body: Text, headers: Text) -> RestAnswer
uses net or fail
{
    let raw = try request(method, url, body, headers)
    let code = try json_int(raw, "status")
    let got = try json_get(raw, "body")
    return RestAnswer(status: code, body: got, raw: raw)
}

// A reply header, under the spelling given or all in lower case.
fn header_of(answer: RestAnswer, name: Text) -> Text or fail {
    if json_has(answer.raw, "headers." + name) {
        return try json_get(answer.raw, "headers." + name)
    }
    return try json_get(answer.raw, "headers." + lower(name))
}

// Headers from a map, as `call` and `request` take them:
// rest.header_map({"Accept": "application/json"})
fn header_map(of: Map of Text to Text) -> Text {
    return json_of(of)
}

// A request whose body is JSON, and which asks for JSON back. `extra` is
// any other header; pass {} for none. The body is JSON text - json_of(...)
// of a map or a record - or "" for no body.
fn call_json(method: Text, url: Text, body: Text, extra: Map of Text to Text) -> RestAnswer
uses net or fail
{
    let with_type = put(extra, "Content-Type", "application/json")
    let all = put(with_type, "Accept", "application/json")
    return try call(method, url, body, json_of(all))
}

// Is this a status worth asking again for: told to slow down (429), or the
// far side, or something in front of it, not answering (502, 503, 504)?
fn worth_retrying(code: Int) -> Bool {
    return code == 429 or code == 502 or code == 503 or code == 504
}

fn succeeded(answer: RestAnswer) -> Bool {
    return answer.status >= 200 and answer.status < 300
}

// `call`, asked again while the request does not get through or the answer
// is worth_retrying - at most `attempts` times in all, and never more than
// ten. There is no pause between attempts: a program has no clock to wait
// on unless it is granted one. Every attempt is a net operation and counts
// against net@N. A request that is not safe to repeat - most POSTs - takes
// attempts 1.
fn call_retrying(method: Text, url: Text, body: Text, headers: Text, attempts: Int) -> RestAnswer
uses net or fail
{
    let most = attempts
    if most > 10 {
        most = 10
    }
    let last = "no attempt was made"
    let tried = 0
    while tried < most {
        tried = tried + 1
        check call(method, url, body, headers) {
            ok answer {
                if not worth_retrying(answer.status) or tried == most {
                    return answer
                }
                last = format("status {}", answer.status)
            }
            fail why {
                last = why
            }
        }
    }
    fail format("gave up after {} attempt(s): {}", tried, last)
}

// The items of a JSON list inside a reply, each as JSON text:
// rest.items(body, "value") for {"value": [...]}, rest.items(body, "") for
// a reply that is a list itself.
fn items(body: Text, path: Text) -> List of Text or fail {
    let n = try json_len(body, path)
    let out: List of Text = []
    let i = 0
    while i < n {
        out = push(out, try json_get(body, format("{}[{}]", path, i)))
        i = i + 1
    }
    return out
}

// What follows `prefix` in `text`, or a failure when `text` does not begin
// with it: how a "next page" link is held to the host it must stay on.
fn after_prefix(text: Text, prefix: Text) -> Text or fail {
    if prefix == "" {
        return text
    }
    let tail = ""
    let i = 0
    for piece in split(text, prefix) {
        if i == 0 and piece != "" {
            fail format("'{}' does not begin with '{}'", text, prefix)
        }
        if i == 1 {
            tail = piece
        }
        if i > 1 {
            tail = tail + prefix + piece
        }
        i = i + 1
    }
    if i < 2 {
        fail format("'{}' does not begin with '{}'", text, prefix)
    }
    return tail
}

// A path with no leading '/', so that it can follow a base that ends in one.
fn no_leading_slash(path: Text) -> Text {
    check after_prefix(path, "/") {
        ok tail {
            return tail
        }
        fail why {
            return path
        }
    }
    return path
}
