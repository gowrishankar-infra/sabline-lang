// Maps, "modelled as values plus which keys are present" (SPEC.md 9.3).

// ==== put_then_has
// expect: proven mark
fn mark(m: Map of Text to Int) -> Map of Text to Int
    ensures has(result, "k") and get_or(result, "k", 0) == 7
{
    return put(m, "k", 7)
}

// ==== an_unchanged_map_refuted
// expect: E700 line 3
fn mark(m: Map of Text to Int) -> Map of Text to Int
    ensures get_or(result, "k", 0) == 7
{
    return m
}

// ==== a_map_literal_is_left_to_runtime
// expect: runtime lookup
fn lookup(t: Text) -> Int
    ensures result >= 0
{
    let m = {"a": 1}
    return get_or(m, t, 0)
}
