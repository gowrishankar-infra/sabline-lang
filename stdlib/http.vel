// Talking to the web, without the plumbing.
//
// import "http.vel" as http
// check http.get(url) { ok body { ... } fail why { ... } }

fn get(url: Text) -> Text uses net or fail {
    return try fetch(url)
}

fn status(url: Text) -> Int uses net or fail
    ensures result >= 0
{
    let code = try fetch_status(url)
    if code < 0 {
        fail "that is not a status"
    }
    return code
}

fn ok(url: Text) -> Bool uses net or fail {
    let code = try status(url)
    return code >= 200 and code < 300
}

fn send(url: Text, body: Text) -> Text uses net or fail {
    return try post(url, body)
}

fn get_json(url: Text, path: Text) -> Text uses net or fail {
    let body = try fetch(url)
    return try json_get(body, path)
}

record Answer {
    status: Int
    body: Text
    raw: Text
}

fn call(method: Text, url: Text, body: Text, headers: Text) -> Answer
uses net or fail
{
    let raw = try request(method, url, body, headers)
    let code = try json_int(raw, "status")
    let got = try json_get(raw, "body")
    return Answer(status: code, body: got, raw: raw)
}

fn body_of(answer: Answer) -> Text {
    return answer.body
}

fn code_of(answer: Answer) -> Int {
    return answer.status
}

fn header_of(answer: Answer, name: Text) -> Text or fail {
    return try json_get(answer.raw, format("headers.{}", name))
}

fn get_with(url: Text, headers: Text) -> Text uses net or fail {
    let answer = try request("GET", url, "", headers)
    return try json_get(answer, "body")
}

fn post_json(url: Text, body: Text) -> Text uses net or fail {
    let headers = "{\"Content-Type\": \"application/json\"}"
    let answer = try request("POST", url, body, headers)
    return try json_get(answer, "body")
}

// ---- 8.5: what the batteries needed (azure.vel, k8s.vel, github.vel,
// aws.vel), and any other program that talks to a REST API -----------------

// Headers from a map, as `call` and `request` take them:
// http.header_map({"Accept": "application/json"})
fn header_map(of: Map of Text to Text) -> Text {
    return json_of(of)
}

// A request whose body is JSON, and which asks for JSON back. `extra` is
// any other header; pass {} for none. The body is JSON text - json_of(...)
// of a map or a record - or "" for no body.
fn call_json(method: Text, url: Text, body: Text, extra: Map of Text to Text) -> Answer
uses net or fail
{
    let with_type = put(extra, "Content-Type", "application/json")
    let all = put(with_type, "Accept", "application/json")
    return try call(method, url, body, json_of(all))
}

// Is this a status worth asking again for: told to slow down (429), or the
// far side, or something in front of it, not answering (502, 503, 504)?
fn worth_retrying(code: Int) -> Bool {
    return code == 429 or code == 502 or code == 503 or code == 504
}

fn succeeded(answer: Answer) -> Bool {
    return answer.status >= 200 and answer.status < 300
}

// `call`, asked again while the request does not get through or the answer
// is worth_retrying - at most `attempts` times in all, and never more than
// ten. There is no pause between attempts: a program has no clock to wait
// on unless it is granted one. Every attempt is a net operation and counts
// against net@N. A request that is not safe to repeat - most POSTs - takes
// attempts 1.
fn call_retrying(method: Text, url: Text, body: Text, headers: Text, attempts: Int) -> Answer
uses net or fail
{
    let most = attempts
    if most > 10 {
        most = 10
    }
    let last = "no attempt was made"
    let tried = 0
    while tried < most {
        tried = tried + 1
        check call(method, url, body, headers) {
            ok answer {
                if not worth_retrying(answer.status) or tried == most {
                    return answer
                }
                last = format("status {}", answer.status)
            }
            fail why {
                last = why
            }
        }
    }
    fail format("gave up after {} attempt(s): {}", tried, last)
}

// The items of a JSON list inside a reply, each as JSON text:
// http.items(body, "value") for {"value": [...]}, http.items(body, "") for
// a reply that is a list itself.
fn items(body: Text, path: Text) -> List of Text or fail {
    let n = try json_len(body, path)
    let out: List of Text = []
    let i = 0
    while i < n {
        out = push(out, try json_get(body, format("{}[{}]", path, i)))
        i = i + 1
    }
    return out
}

// What follows `prefix` in `text`, or a failure when `text` does not begin
// with it: how a "next page" link is held to the host it must stay on.
fn after_prefix(text: Text, prefix: Text) -> Text or fail {
    if prefix == "" {
        return text
    }
    // (this file has a `get` of its own, so the pieces are walked, not
    // indexed)
    let rest = ""
    let i = 0
    for piece in split(text, prefix) {
        if i == 0 and piece != "" {
            fail format("'{}' does not begin with '{}'", text, prefix)
        }
        if i == 1 {
            rest = piece
        }
        if i > 1 {
            rest = rest + prefix + piece
        }
        i = i + 1
    }
    if i < 2 {
        fail format("'{}' does not begin with '{}'", text, prefix)
    }
    return rest
}

// A path with no leading '/', so that it can follow a base that ends in one.
fn no_leading_slash(path: Text) -> Text {
    check after_prefix(path, "/") {
        ok rest {
            return rest
        }
        fail why {
            return path
        }
    }
    return path
}
