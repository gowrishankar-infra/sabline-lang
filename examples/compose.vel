// v0.8: proofs COMPOSE. To prove shipping's promise, Sabline must rely
// on clamp_pos's promise (result >= 0). It never looks inside
// clamp_pos while proving shipping - it trusts the contract, which it
// proved separately. Verification scales function by function.

fn clamp_pos(n: Int) -> Int
    ensures result >= 0
{
    if n < 0 {
        return 0
    }
    return n
}

fn shipping(weight: Int) -> Int
    requires weight >= 0
    ensures result >= 50
{
    return 50 + clamp_pos(weight - 10) * 2
}

fn main() uses io {
    print("shipping(5) = " + shipping(5))
    print("shipping(100) = " + shipping(100))
}
