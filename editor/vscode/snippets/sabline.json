{
  "Function with promises": {
    "prefix": "fnp",
    "body": [
      "fn ${1:name}(${2:n}: ${3:Int}) -> ${4:Int}",
      "    requires ${5:n >= 0}",
      "    ensures ${6:result >= 0}",
      "{",
      "    $0",
      "}"
    ],
    "description": "A function whose promises the prover checks"
  },
  "Plain function": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:n}: ${3:Int}) -> ${4:Int} {",
      "    $0",
      "}"
    ],
    "description": "A function"
  },
  "Function that can fail": {
    "prefix": "fnfail",
    "body": [
      "fn ${1:name}(${2:text}: Text) -> ${3:Int} or fail {",
      "    if ${4:something is wrong} {",
      "        fail format(\"${5:why}\", ${6:value})",
      "    }",
      "    return $0",
      "}"
    ],
    "description": "A function whose failure callers must handle"
  },
  "Function with effects": {
    "prefix": "fnuses",
    "body": [
      "fn ${1:name}(${2:arg}: ${3:Text}) uses ${4|io,fs,net,clock,rand,ffi|} {",
      "    $0",
      "}"
    ],
    "description": "A function that declares what it may do"
  },
  "main": {
    "prefix": "main",
    "body": [
      "fn main() uses io {",
      "    $0",
      "}"
    ],
    "description": "Where a program starts"
  },
  "check a call that can fail": {
    "prefix": "check",
    "body": [
      "check ${1:call()} {",
      "    ok ${2:value} {",
      "        $0",
      "    }",
      "    fail why {",
      "        print(format(\"${3:could not do it}: {}\", why))",
      "    }",
      "}"
    ],
    "description": "Handle both outcomes of a fallible call"
  },
  "try": {
    "prefix": "try",
    "body": ["let ${1:value} = try ${2:call()}$0"],
    "description": "Pass a failure up to your caller"
  },
  "for over a range": {
    "prefix": "forr",
    "body": [
      "for ${1:i} in ${2:0} to ${3:n} {",
      "    $0",
      "}"
    ],
    "description": "Count from one number to another"
  },
  "for over a list": {
    "prefix": "for",
    "body": [
      "for ${1:item} in ${2:items} {",
      "    $0",
      "}"
    ],
    "description": "Walk a list"
  },
  "while with an invariant": {
    "prefix": "whileinv",
    "body": [
      "while ${1:i < n}",
      "invariant ${2:total >= 0}",
      "{",
      "    $0",
      "}"
    ],
    "description": "A loop the prover can reason about"
  },
  "record": {
    "prefix": "record",
    "body": [
      "record ${1:Name} {",
      "    ${2:field}: ${3:Int}",
      "    $0",
      "}"
    ],
    "description": "An immutable record type"
  },
  "inline function value": {
    "prefix": "lambda",
    "body": ["fn(${1:n}: ${2:Int}) -> ${3:Bool} { return $0 }"],
    "description": "A function written where it is used"
  },
  "test": {
    "prefix": "test",
    "body": [
      "fn test_${1:what_it_does}() -> Bool {",
      "    return $0",
      "}"
    ],
    "description": "A test sabline test will run"
  },
  "import": {
    "prefix": "import",
    "body": ["import \"${1|std.vel,http.vel,db.vel,dates.vel,csv.vel,log.vel,env_tools.vel|}\"$0"],
    "description": "Bring in a library"
  },
  "named import": {
    "prefix": "importas",
    "body": ["import \"${1:lib/thing.vel}\" as ${2:thing}$0"],
    "description": "Bring in a library behind its own name"
  },
  "read JSON": {
    "prefix": "json",
    "body": [
      "check json_get(${1:doc}, \"${2:user.name}\") {",
      "    ok ${3:value} {",
      "        $0",
      "    }",
      "    fail why {",
      "        print(why)",
      "    }",
      "}"
    ],
    "description": "Read a field out of a JSON document"
  },
  "call Python": {
    "prefix": "py",
    "body": ["let ${1:answer} = try py_json(\"${2:math}\", \"${3:sqrt}\", format(\"[{}]\", ${4:value}))$0"],
    "description": "Call a Python function (needs uses ffi)"
  }
}
