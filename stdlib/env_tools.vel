// The environment a program runs in. Reading it is the `env` effect
// (since 3.0), so an io-only budget cannot reach a secret through it,
// and from 6.0 what comes back is a `Secret of Text`: the compiler will
// not let it be printed, written, sent or passed to Python, and will
// not let a program branch on it either (SPEC.md 3.1).
//
// import "env_tools.vel" as sys

fn setting(name: Text, fallback: Text) -> Secret of Text uses env {
    return env(name, fallback)
}

// A setting the program says is not a secret - a user name, a region, a
// log level. Saying so is what `declassify` is for: the reason below is
// what `sabline audit` reports, and an operator who does not want any
// setting made public refuses the `declassify` grant.
fn public_setting(name: Text, fallback: Text) -> Text uses env, declassify {
    let raw = setting(name, fallback)
    return declassify(raw, "this setting is read to be shown, not kept")
}

// The number has to be declassified before it can be looked at: a
// program cannot compare a secret and act on the answer.
fn number_setting(name: Text, fallback: Int) -> Int uses env, declassify {
    let raw = setting(name, "")
    let shown = declassify(raw, "a numeric setting is a number, not a secret")
    if shown == "" {
        return fallback
    }
    check to_int(shown) {
        ok n {
            return n
        }
        fail why {
            return fallback
        }
    }
    return fallback
}

fn succeed() uses io {
    exit_with(0)
}

fn give_up(why: Text) uses io {
    print(why)
    exit_with(1)
}
