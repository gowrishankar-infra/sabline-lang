// sabline examples/net.vel --allow io,net
//
// fetch is REAL - this program performs an actual HTTP GET. It needs
// an internet connection, so it is NOT part of run_tests.py.
// Since v2.0 the network's unreliability is part of the signature:
// fetch can fail, so homepage says 'or fail', and main handles it.

fn homepage(url: Text) -> Text uses net or fail {
    return try fetch(url)
}

fn main() uses io, net {
    check homepage("https://raw.githubusercontent.com/octocat/Hello-World/master/README") {
        ok body {
            print("fetched " + length(body) + " characters:")
            print(body)
        }
        fail why {
            print("the network said no: " + why)
        }
    }
}
