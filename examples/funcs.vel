// v1.6: functions are values. Pass them by name, call them through
// parameters - map and filter, written in Sabline itself.
// Only PURE functions can be passed: nothing smuggled, ever.

fn double(n: Int) -> Int {
    return n * 2
}

fn is_even(n: Int) -> Bool {
    return n % 2 == 0
}

fn apply_to_each(xs: List of Int, f: fn(Int) -> Int) -> List of Int
    requires length(xs) > 0
{
    let out = [f(get(xs, 0))]
    let i = 1
    while i < length(xs) {
        out = push(out, f(get(xs, i)))
        i = i + 1
    }
    return out
}

fn count_where(xs: List of Int, keep: fn(Int) -> Bool) -> Int {
    let n = 0
    let i = 0
    while i < length(xs) {
        if keep(get(xs, i)) {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn main() uses io {
    let nums = [1, 2, 3, 4, 5]
    print("doubled: " + apply_to_each(nums, double))
    print("evens: " + count_where(nums, is_even))
    let f = double
    print(f)
    print("via variable: " + f(21))
}
