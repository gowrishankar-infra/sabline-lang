// SPEC.md 9.1 and LLM.md "The whole syntax": the parts of a signature.

fn discount(price: Int, rate: Int) -> Int
    requires price >= 0
    requires rate >= 0 and rate <= 100
    ensures result >= 0
    ensures result <= price
{
    return price - price * rate / 100
}

fn greet(name: Text) uses io, fs {
    print("hello, " + name)
}

fn parse_age(text: Text) -> Int or fail {
    return try to_int(text)
}

fn first(xs: List of T) -> T for any T
    requires length(xs) > 0
{
    return get(xs, 0)
}

fn pick(a: Map of K to V, b: List of K) -> List of V or fail uses io for any K, V {
    return []
}

fn nothing() {
    return
}
