// v2.14: text scanning runs as machine code. Text crosses into native
// code as Unicode code points plus a length - so length() still counts
// characters, not bytes, and non-English text behaves identically.
// code_at(t, i) gives the code point at a position, no allocation.
//
// sabline examples/native_text.vel --time
// sabline examples/native_text.vel --no-native --time

fn count_letters(word: Text) -> Int
    ensures result >= 0
{
    let n = 0
    let i = 0
    while i < length(word) {
        let c = code_at(word, i)
        if c >= 97 and c <= 122 {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

fn scan(word: Text, rounds: Int) -> Int {
    let total = 0
    let r = 0
    while r < rounds {
        total = total + count_letters(word)
        r = r + 1
    }
    return total
}

fn main() uses io {
    let text = "the quick brown fox jumps over the lazy dog"
    print(format("lowercase letters: {}", count_letters(text)))
    print(format("scanned 2000 times: {}", scan(text, 2000)))
    print(format("unicode is safe too: {}", count_letters("héllo wörld")))
}
