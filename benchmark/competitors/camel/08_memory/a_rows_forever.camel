# Keeps every generated row in a list that is never emptied.
# NOT-LIKE-FOR-LIKE: CaMeL has no list.append: each row is added by building a new list, rows = rows + [row].
rows = []
i = 0
while True:
    rows = rows + [" ".join([str(i + k) for k in range(100)])]  # DANGER
    i = i + 1
print(len(rows))
