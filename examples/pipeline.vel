// v2.34: what an unattended job looks like.
//
// sabline examples/pipeline.vel < data.csv               (io is enough)
// sabline examples/pipeline.vel < data.csv 2>/dev/null   (results only)
//
// Messages go to the error channel through log, results go to the
// output channel through print, and the exit code says whether it
// worked - so a scheduler, a pipeline or a person can all tell.

import "csv.vel" as csv
import "log.vel" as log

fn total_of(text: Text) -> Int or fail
    ensures result >= 0
{
    let total = 0
    for row in csv.rows_of(text) {
        if length(row) > 0 {
            let amount = try csv.column_int(row, 1)
            if amount < 0 {
                fail format("a negative amount in: {}", row)
            }
            total = total + amount
        }
    }
    return total
}

fn main() uses io {
    log.info("reading expenses")
    let data = "chai,2500\nbook,45000\nauto,12000"
    check total_of(data) {
        ok paise {
            print(format("total: {}", paise))
            log.info(format("{} rows read", length(csv.rows_of(data))))
            log.event("run_finished", log.field("status", "ok"))
        }
        fail why {
            log.die(why)
        }
    }
}
