// The control: a running product modulo the prime 2**61 - 1, as a hash does. Every product passes 64 bits on the way; every result fits.
fn main() uses io {
    let m = 2305843009213693951
    let r = 1
    for i in 0 to 100 {
        r = r * 1234567890123 % m
    }
    print(format("product {}", r))
}
