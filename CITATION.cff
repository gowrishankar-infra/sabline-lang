    given-names: Gowri Shankar
    orcid: "https://orcid.org/0009-0007-0004-2955"
doi: "10.5281/zenodo.22952528"
repository-code: "https://github.com/gowrishankar-infra/sabline-lang"
url: "https://sabline.dev/"
license: MIT
version: "8.7.0"
date-released: "2026-09-20"
keywords:
  - programming language
  - effect system
  - capabilities
  - sandbox
  - contracts
  - verification
