// v2.13: pure functions that READ lists now compile to machine code.
// The list is handed to native code as a pointer and a length, and
// every read is bounds-guarded: an out-of-range position records the
// mistake instead of touching memory, and you get the same error you
// would have got interpreted.
//
// Compare for yourself:
// sabline examples/native_list.vel --time
// sabline examples/native_list.vel --no-native --time

fn build(n: Int) -> List of Int
    requires n >= 0
{
    let xs: List of Int = []
    let i = 0
    while i < n {
        xs = push(xs, i)
        i = i + 1
    }
    return xs
}

fn sum_squares(xs: List of Int) -> Int {
    let total = 0
    let round = 0
    while round < 50 {
        let i = 0
        while i < length(xs) {
            total = total + get(xs, i) * get(xs, i)
            i = i + 1
        }
        round = round + 1
    }
    return total
}

fn main() uses io {
    let xs = build(300)
    print(format("sum of squares, 50 rounds: {}", sum_squares(xs)))
}
