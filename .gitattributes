* text=auto
# vendored byte for byte; check_library.py checks its sha256
tests/sarif-schema-2.1.0.json -text
# check_permissions.py reads these line ends as they are: CRLF, and tabs
tests/permissions/** -text
# a receipt names each standard-library file a run used by the sha256 of its
# bytes on disk, and `sabline replay` compares that digest with the file: a
# checkout that rewrote line ends would give a Windows clone a different
# digest from every other one (the receipts under
# incidents/replit-agent-database-deletion record db.vel's)
stdlib/*.vel eol=lf
# the incident catalogue's evidence is recorded byte for byte, and one
# recording holds the sha256 `sabline add` computed from a program on disk,
# so no file here may be rewritten on checkout (check_incidents.py)
incidents/** -text
