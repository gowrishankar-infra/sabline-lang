{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.gowrishankar-infra/sabline",
  "title": "Sabline",
  "description": "Write Sabline, audit what it can touch, and run it under an effect budget.",
  "repository": {
    "url": "https://github.com/gowrishankar-infra/sabline-lang",
    "source": "github"
  },
  "websiteUrl": "https://sabline.dev/",
  "version": "8.6.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "sabline-lang",
      "version": "8.6.0",
      "runtimeHint": "python",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "-m"
        },
        {
          "type": "positional",
          "value": "sabline_mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    },
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "sabline-lang",
      "version": "8.6.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
