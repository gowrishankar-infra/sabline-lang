// Secret of T (SPEC.md 3.1; LLM.md rule 17): nothing that emits takes
// one (E560), nothing branches on one (E563), a signature says Secret,
// and declassify with a reason written in the call is the only way out.

// ==== a_secret_printed
// expect: E560 line 4
fn main() uses io, env {
    let key = env("API_KEY", "")
    print(key)
}

// ==== a_secret_given_to_a_builtin_that_can_fail
// expect: E560 line 4
fn main() uses io, env {
    let key = env("API_KEY", "")
    check to_int(key) {
        ok n {
            print("a number")
        }
        fail why {
            print(why)
        }
    }
}

// ==== a_secret_as_a_failure_reason
// expect: E560 line 4
fn f() -> Int or fail uses env {
    let key = env("API_KEY", "")
    fail key
}

// ==== a_record_holding_one_is_refused_whole
// expect: E560 line 8
record Config {
    region: Text
    key: Secret of Text
}
fn main() uses io, env {
    let c = Config(region: "eu", key: env("API_KEY", ""))
    print(c)
}

// ==== no_type_variable_is_bound_to_one
// expect: E560 line 11
fn contains_item(xs: List of T, item: T) -> Bool for any T {
    let found = false
    for x in xs {
        found = found or x == item
    }
    return found
}
fn main() uses io, env {
    let key = env("API_KEY", "")
    let guess = contains_item([key], key)
}

// ==== no_branch_on_a_comparison_with_one
// expect: E563 line 4
fn main() uses io, env {
    let key = env("API_KEY", "")
    if key == "" {
        print("unset")
    }
}

// ==== no_loop_on_its_length
// expect: E563 line 5
fn main() uses io, env {
    let key = env("API_KEY", "")
    let i = 0
    while i < length(key) {
        i = i + 1
    }
}

// ==== said_in_the_signature
// expect: ok
fn config(name: Text) -> Secret of Text uses env {
    return env(name, "")
}
fn bearer(k: Secret of Text) -> Secret of Text {
    return "Bearer " + k
}
fn pass(s: Secret of T) -> Secret of T for any T {
    return s
}
fn main() uses io, env {
    let key = config("API_KEY")
    let header: Secret of Text = bearer(key)
    let size: Secret of Int = length(key)
    let empty: Secret of Bool = key == ""
    let same: Secret of Text = pass(key)
    let keys = [key, header]
    let how_many: Int = length(keys)
    print("built a header, and the key is not in this output")
}

// ==== a_promise_may_be_about_one
// expect: ok
fn use_key(key: Secret of Text) -> Int
    requires length(key) > 0
{
    return 1
}

// ==== declassify_reason_written_in_the_call
// expect: E561 line 5
fn main() uses io, env, declassify {
    let key = env("API_KEY", "")
    let why = "because"
    let open = declassify(key, why)
}

// ==== declassify_then_branch
// expect: ok
fn main() uses io, env, declassify {
    let key = env("API_KEY", "")
    let missing = declassify(key == "", "whether a key is set at all is not the key")
    if missing {
        print("API_KEY is not set")
    }
}

// ==== a_local_named_like_print
// expect: E560 line 4
fn leak(k: Secret of Text) uses io {
    let print = 0
    print(k)
}
// 7.0.0 to 8.1.1 skipped the sink check for any call to a local's name,
// so this compiled and a run printed the secret (fixed in 8.2)
