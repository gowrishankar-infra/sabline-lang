{
  "name": "sabline",
  "displayName": "Sabline",
  "description": "Run code an AI wrote without handing it everything you can reach. Each function declares what it may touch. You grant the run one folder, one host or a number of calls, and the runtime refuses anything else the moment it's tried.",
  "version": "8.6.0",
  "publisher": "gowrishankar-infra",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "contributes": {
    "languages": [
      {
        "id": "sabline",
        "aliases": [
          "Sabline",
          "sabline"
        ],
        "extensions": [
          ".vel"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sabline",
        "scopeName": "source.sabline",
        "path": "./syntaxes/sabline.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Sabline",
      "properties": {
        "sabline.command": {
          "type": "string",
          "default": "sabline",
          "description": "How to run Sabline (a path, if it is not on your PATH)."
        },
        "sabline.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Check the file and prove its promises when you save."
        }
      }
    },
    "snippets": [
      {
        "language": "sabline",
        "path": "./snippets/sabline.json"
      }
    ]
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:sabline"
  ],
  "license": "MIT",
  "icon": "icon.png",
  "keywords": ["sabline", "ai-agents", "mcp", "sandbox", "permissions", "least-privilege", "effects", "verification", "contracts", "formal methods"],
  "repository": {
    "type": "git",
    "url": "https://github.com/gowrishankar-infra/sabline-lang"
  },
  "bugs": {
    "url": "https://github.com/gowrishankar-infra/sabline-lang/issues"
  },
  "homepage": "https://sabline.dev/",
  "galleryBanner": {
    "color": "#101418",
    "theme": "dark"
  }
}