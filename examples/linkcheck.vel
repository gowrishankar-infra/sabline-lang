// A link checker you would actually run.
//
// sabline examples/linkcheck.vel --allow io,net https://example.com https://dead.invalid
// sabline examples/linkcheck.vel --allow io,net < urls.txt
//
// Reads URLs from the command line or standard input, asks each one
// for its status, reports what it found, and exits non-zero if any
// link is broken - so a scheduler or a pipeline can act on it.
//
// Results go to the output channel and progress to the error channel,
// so `linkcheck ... 2>/dev/null` gives a clean report.

import "http.vel" as http
import "log.vel" as log
import "std.vel"

record Result {
    url: Text
    status: Int
    note: Text
}

fn verdict(status: Int) -> Text {
    if status == 0 {
        return "unreachable"
    }
    if status >= 200 and status < 300 {
        return "ok"
    }
    if status >= 300 and status < 400 {
        return "moved"
    }
    if status >= 400 and status < 500 {
        return "missing"
    }
    return "server error"
}

fn is_bad(r: Result) -> Bool {
    return r.status == 0 or r.status >= 400
}

fn check_one(url: Text) -> Result uses io, net {
    log.info(format("checking {}", url))
    check http.call("GET", url, "", "{}") {
        ok answer {
            let code = http.code_of(answer)
            return Result(url: url, status: code, note: verdict(code))
        }
        fail why {
            return Result(url: url, status: 0, note: why)
        }
    }
    return Result(url: url, status: 0, note: "no answer")
}

fn gather() -> List of Text uses io {
    let given = args()
    if length(given) > 0 {
        return given
    }
    let found: List of Text = []
    let line = read_line()
    while length(line) > 0 {
        found = push(found, line)
        line = read_line()
    }
    return found
}

fn main() uses io, net {
    let urls = gather()
    if length(urls) == 0 {
        print("usage: linkcheck <url> [url ...]   (or pipe a list in)")
        exit_with(2)
    }
    let results: List of Result = []
    for url in urls {
        results = push(results, check_one(url))
    }
    let broken = 0
    for r in results {
        print(format("{}  {}  {}", r.status, r.note, r.url))
        if is_bad(r) {
            broken = broken + 1
        }
    }
    print(format("{} of {} link(s) broken", broken, length(results)))
    if broken > 0 {
        log.error(format("{} broken link(s)", broken))
        exit_with(1)
    }
    log.info("all links fine")
}
