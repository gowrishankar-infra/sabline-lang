fn sum_to(n: Int) -> Int {
    let total = 0
    for i in 0 to n
    invariant total >= 0
    {
        total = total + i
    }
    return total
}

fn sum_of(xs: List of Int) -> Int {
    let total = 0
    for x in xs
    invariant total >= 0
    {
        total = total + x
    }
    return total
}

fn grid(n: Int) -> Int {
    let cells = 0
    for row in 0 to n {
        for col in 0 to n {
            cells = cells + 1
        }
    }
    return cells
}
