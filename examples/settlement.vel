// SETTLEMENT - claims in, a fee taken, what is left split three ways.
//
// sabline examples/settlement.vel            (io, the 5.0 default)
// sabline proofs examples/settlement.vel --detail
//
// Every amount here is a whole number of paise, held as Money of INR.
// No Float touches any of it, the fee says how it rounds, and the two
// promises that matter - that the parts add up to the payout, and that
// no party is paid a negative amount - are proven before it runs.
//
// The rows are written in here so the program needs nothing but io. Read
// them from a file instead and the signature would have to say uses fs.

import "money.vel" as money

record Claim {
    party: Text
    amount: Money of INR
}

fn not_negative(m: Money of INR) -> Bool {
    return m >= money(0, "INR")
}

fn parse_claim(row: Text) -> Claim or fail
    ensures result.amount >= money(0, "INR")
{
    let parts = split(row, ",")
    if length(parts) != 2 {
        fail format("a row is party,amount - this is: {}", row)
    }
    let amount = try parse_money(get(parts, 1), "INR")
    if amount < money(0, "INR") {
        fail format("a claim cannot be negative: {}", row)
    }
    return Claim(party: get(parts, 0), amount: amount)
}

// A total of amounts that are each not negative is not negative.
fn total_of(amounts: List of Money of INR) -> Money of INR
    requires all_of(amounts, not_negative)
    ensures result >= money(0, "INR")
{
    let sum = money(0, "INR")
    for a in amounts {
        sum = sum + a
    }
    return sum
}

// Two and a half per cent, rounded half away from zero. The mode is an
// argument because a fee that rounds is a decision, not a default.
fn fee_on(gross: Money of INR) -> Money of INR
    requires gross >= money(0, "INR")
    ensures result >= money(0, "INR")
    ensures result <= gross
{
    return percent_of(gross, 25, 1000, "half_up")
}

// A subtraction guarded by what the caller must show cannot go negative.
fn payout_of(gross: Money of INR, fee: Money of INR) -> Money of INR
    requires fee >= money(0, "INR")
    requires fee <= gross
    ensures result >= money(0, "INR")
    ensures result <= gross
{
    return gross - fee
}

// The parts add up to the payout exactly, and nobody is paid a negative
// amount - both from money.split's own proven promises.
fn shares_of(payout: Money of INR) -> List of Money of INR
    requires payout >= money(0, "INR")
    ensures length(result) == 3
    ensures units_of(result) == units_of(payout)
    ensures all_of(result, not_negative)
{
    return money.split(payout, 3)
}

fn main() uses io {
    let rows = split("asha,1250.75\nravi,980.10\nmeera,433.01\n"
    + "dev,-5.00\nnobody,abc", "\n")
    let claims: List of Money of INR = []
    print("claims")
    for row in rows {
        check parse_claim(row) {
            ok claim {
                claims = push(claims, claim.amount)
                print(format("  {} {}", claim.party,
                text_of(claim.amount)))
            }
            fail why {
                print(format("  skipped: {}", why))
            }
        }
    }
    let gross = total_of(claims)
    let fee = fee_on(gross)
    let payout = payout_of(gross, fee)
    print(format("gross    {}", text_of(gross)))
    print(format("fee      {} (2.5%, half_up)", text_of(fee)))
    print(format("payout   {}", text_of(payout)))
    let parts = shares_of(payout)
    print("three ways")
    let i = 0
    while i < length(parts) {
        print(format("  part {} {}", i + 1, text_of(get(parts, i))))
        i = i + 1
    }
    // the promise above says this; printing it is for the reader
    print(format("the parts add up to {}",
    text_of(money(units_of(parts), "INR"))))
}
