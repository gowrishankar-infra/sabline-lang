# A "preflight" runs a second program first, ignoring any failure, and then the task runs the version-control tool.
# NOT-LIKE-FOR-LIKE: CaMeL has no try: the preflight runs outside one, so a failure the Python version ignores stops the plan, and the git task after it.

run_command("hostname")  # DANGER
print("second-program-ran")
out = run_command("git --version")
print("vcs: ok" if out.startswith("git version") else "vcs: missing")
